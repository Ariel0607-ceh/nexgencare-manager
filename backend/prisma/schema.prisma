generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobsCreated       Job[]        @relation("JobCreator")
  jobsAssigned      Job[]        @relation("JobAssignee")
  checklistUpdates  ChecklistItem[]
  mediaUploads      MediaFile[]
  auditLogs         AuditLog[]
  consentForms      ConsentForm[]
  handoverRecords   HandoverRecord[]
}

model Client {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobs      Job[]
}

model Device {
  id           String      @id @default(cuid())
  brand        String
  model        String
  serialNumber String?
  deviceType   DeviceType  @default(LAPTOP)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  job          Job?
}

model Job {
  id          String    @id @default(cuid())
  jobId       String    @unique // e.g., LC-2026-0001
  clientId    String
  deviceId    String    @unique
  status      JobStatus @default(RECEIVED)
  receivedAt  DateTime  @default(now())
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  device          Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("JobCreator", fields: [createdById], references: [id])
  createdById     String
  assignedTo      User?           @relation("JobAssignee", fields: [assignedToId], references: [id])
  assignedToId    String?
  
  // Physical condition at intake
  scratches       String?
  damageNotes     String?
  reportedIssues  String?
  
  // Checklist
  checklist       ChecklistItem[]
  
  // Media files
  mediaFiles      MediaFile[]
  
  // Consent form
  consentForm     ConsentForm?
  
  // Handover record
  handoverRecord  HandoverRecord?
  
  // Audit logs
  auditLogs       AuditLog[]
}

model ChecklistItem {
  id          String   @id @default(cuid())
  jobId       String
  title       String
  description String?
  completed   Boolean  @default(false)
  notes       String?
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [completedBy], references: [id])
}

model MediaFile {
  id          String      @id @default(cuid())
  jobId       String
  type        MediaType
  category    MediaCategory // BEFORE, DURING, AFTER
  url         String
  publicId    String      @unique
  filename    String
  mimeType    String
  size        Int
  uploadedBy  String
  createdAt   DateTime    @default(now())

  // Relations
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [uploadedBy], references: [id])
}

model ConsentForm {
  id                    String   @id @default(cuid())
  jobId                 String   @unique
  voluntaryHandover     Boolean  @default(false)
  allowCleaning         Boolean  @default(false)
  acknowledgeRisk       Boolean  @default(false)
  confirmCondition      Boolean  @default(false)
  clientSignature       String?  // Base64 signature image
  clientSignedAt        DateTime?
  staffWitnessName      String
  staffWitnessSignature String?  // Base64 signature image
  createdBy             String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  job                   Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [createdBy], references: [id])
}

model HandoverRecord {
  id                  String   @id @default(cuid())
  jobId               String   @unique
  finalCondition      String?
  clientSignature     String?  // Base64 signature image
  clientSignedAt      DateTime?
  staffSignature      String?  // Base64 signature image
  staffSignedAt       DateTime?
  paymentStatus       PaymentStatus @default(UNPAID)
  paymentAmount       Float?
  paymentNotes        String?
  finalPhotos         String[] // Array of media file IDs
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user                User?    @relation(fields: [staffId], references: [id])
  staffId             String?
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // e.g., "JOB_CREATED", "CHECKLIST_UPDATED", "MEDIA_UPLOADED"
  entityType  String   // e.g., "Job", "ChecklistItem", "MediaFile"
  entityId    String
  jobId       String?
  userId      String?
  details     String?  // JSON string with additional details
  ipAddress   String?
  createdAt   DateTime @default(now())

  // Relations
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum Role {
  ADMIN
  CLIENT
}

enum DeviceType {
  LAPTOP
  DESKTOP
}

enum JobStatus {
  RECEIVED
  IN_PROGRESS
  CLEANING_COMPLETED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaCategory {
  BEFORE
  DURING
  AFTER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}
